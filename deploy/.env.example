# ==================================================
# DeepTrace 环境变量配置
# ==================================================
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置项
# 3. 运行：docker compose up -d
#
# ==================================================

# ==================================================
# Docker 镜像配置（可选）
# ==================================================

# 镜像仓库地址（如果使用私有仓库）
# DOCKER_REGISTRY=registry.example.com/

# 镜像标签
IMAGE_TAG=latest

# ==================================================
# DM8 数据库连接配置（必须修改）
# ==================================================

# DM8 连接字符串
# 格式: dm://用户名:密码@IP地址:端口
# 示例: dm://SYSDBA:MyPassword@192.168.1.100:5236
DATABASE_URL=dm://SYSDBA:Deeptrace2025@192.168.1.100:5236

# ==================================================
# TongRDS (Redis) 连接配置（必须修改）
# ==================================================

# TongRDS IP 地址
REDIS_HOST=192.168.1.101

# TongRDS 端口（默认 6379）
REDIS_PORT=6379

# TongRDS 密码（如果没有密码，留空）
REDIS_AUTH=

# ==================================================
# 应用端口配置（可选修改）
# ==================================================

# Web 应用端口（默认 3000）
WEB_PORT=3000

# Worker 服务端口（默认 5001）
WORKER_PORT=5001

# ==================================================
# 应用配置（建议修改）
# ==================================================

# NextAuth 回调地址
# 生产环境改为实际域名，例如: https://deeptrace.example.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth 密钥（必须修改为随机字符串）
# 生成命令: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-random-secret-key

# ==================================================
# 安全配置（必须修改）
# ==================================================

# 密码盐值（必须修改为随机字符串）
# 生成命令: openssl rand -hex 16
SALT=change-me-to-random-salt

# Worker 认证密码
WORKER_PASSWORD=mybasicauthsecret

# 加密密钥（必须修改为随机字符串）
# 生成命令: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-random-64-char-hex-key

# ==================================================
# 日志配置（可选）
# ==================================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info
